<footer class="gov-footer">
  {# Top Footer Section #}
  <div class="footer-top container">
    <div class="row g-4">

      {# Column 1 - About Organization #}
      <div class="col-lg-4 col-md-6">
        <div class="footer-box">
          <a href="{{ path('<front>') }}" class="footer-logo">
            {% if footer_logo_url %}
              <img src="{{ footer_logo_url }}" alt="Footer Logo" class="img-fluid mb-3">
            {% endif %}
          </a>

        </div>
      </div>

      {# Column 2 - Contact Info #}

       <div class="col-lg-3 col-md-6">
        <div class="footer-box">
          <!-- <h5>Contact Us</h5> -->
          <p class="contact">{{ footer_about }} </p>

          <p class="address-email-contact">
           <i class="bi bi-geo"></i> {{ footer_address }}
          </p>

          <p class="address-email-contact">
            <i class="fas fa-phone-alt text-secondary me-2"></i> {{ contact }}
          </p >

          <p class="address-email-contact">
            <i class="fas fa-envelope text-secondary me-2"></i> {{ header_mail }}
          </p>
          
        </div>
      </div>
    {# Column 2 - First menu Links #}
      <div class="col-lg-2 col-md-6">
        <div class="footer-box">
         {{ footer_first_menu }}
        </div>
      </div>

      {# Column 3 - Second menu Links #}
      <div class="col-lg-3 col-md-6">
        <div class="footer-box">
         <!--  <h5>Important Links</h5> -->
          {{ footer_second_menu }}
        </div>
      </div>

    </div>
  </div>

  {# Bottom Footer #}
  <div class="footer-bottom">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">

      <p class="mb-1 mb-md-0">
        © {{ "now"|date("Y") }} {{ site_name }}. All Rights Reserved.
      </p>

       <p class="mb-0">
       <!--  Last Updated: {{ "now"|date("d M Y") }} -->
        <span class="bottom-footer-link"><a href="#">Terms & Conditions </a></span> <span class="mx-2 text-white">|</span>
        <span class="bottom-footer-link"><a href="/privacy-policy">Privacy Policy</a></span> <span class="mx-2 text-white">|</span>
        <span class="bottom-footer-link"><a href="#">Cookie Policy</a></span>
      </p> 
    
    </div>
  </div>

</footer>