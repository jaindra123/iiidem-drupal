
{% include '@iiidem_theme/components/header/header.twig' with {
  logo: logo,
  site_name: site_name,
  page: page
} %}

<main>
    {{ content.field_components }}

    <!-- Carousel Start -->
    {% if node is defined and node.field_hero_banner is not empty %}
      <div class="carousel-header">
        <div id="carouselId" class="carousel slide" data-bs-ride="carousel">

          <!-- Indicators -->
          <ol class="carousel-indicators">
            {% for item in node.field_hero_banner %}
              <li data-bs-target="#carouselId"
                  data-bs-slide-to="{{ loop.index0 }}"
                  class="{% if loop.first %}active{% endif %}">
              </li>
            {% endfor %}
          </ol>

          <!-- Slides -->
          <div class="carousel-inner" role="listbox">

            {% for item in node.field_hero_banner %}
              {% set slide = item.entity %}

              <div class="carousel-item {% if loop.first %}active{% endif %}">

                {% if slide.field_slide_image.entity %}
                  <img src="{{ file_url(slide.field_slide_image.entity.fileuri) }}"
                       class="d-block w-100 img-fluid"
                       alt="{{ slide.field_title.value }}">
                {% endif %}

                <div class="carousel-caption">
                  <h1>{{ slide.field_title.value }}</h1>
                  <p>{{ slide.field_slide_description.value }}</p>
                </div>

              </div>

            {% endfor %}

          </div>

          <!-- Controls -->
          <button class="carousel-control-prev" type="button" data-bs-target="#carouselId" data-bs-slide="prev">
            <span class="carousel-control-prev-icon bg-secondary" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>

          <button class="carousel-control-next" type="button" data-bs-target="#carouselId" data-bs-slide="next">
            <span class="carousel-control-next-icon bg-secondary" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>

        </div>
      </div>
    {% endif %}
    <!-- Homepage Carousel End -->

    <!-- Services Start -->
        {# {{ page.homepage_services }} #}
      
    <!-- Services End -->

     <!-- training Start -->
      <div id="skip_main_content"> {{ page.homepage_training }} </div>
    <!-- training End -->

    <section class="media-section py-5" >
        <div class="swiper-wrapper">
           <img src="https://iiidem.ddev.site/sites/default/files/2026-05/555.png" alt="" style="width: 100%;">
        </div>
    </section>

   <!-- Statistic Section start by custom block content (Home statistical data)-->

    <section class="about-section">
  <div class="container-fluid px-5">
    <h2 class="about-title">
      About IIIDEM (India International Institute of Democracy and Election Management)
    </h2>
    <div class="row">
      <!-- Left Content -->
      <div class="col-lg-4">
        <div class="about-left">
          <div class="logo-box">
             {% if home_about_block.field_image.entity %}
              {% set logo_img = file_url(home_about_block.field_image.entity.fileuri) %}
            {% endif %}
            <img src="{{logo_img}}" alt="IIIDEM Logo">
          </div>
          <p class="about-text">
            {{ home_about_block.field_description.value|striptags }}
          </p>
          <a href="/about-us" class="read-btn">
            Read More <i class="bi bi-arrow-up-right"></i>
          </a>
        </div>
      </div>

      <!-- Right Stats -->
      <div class="col-lg-8">
       <div class="stats-wrapper">
        <!-- Dynamic Background Image -->
          {% if home_about_block.field_home_iiidem_image.entity %}
            {% set iiidem_img = file_url(home_about_block.field_home_iiidem_image.entity.fileuri) %}
          {% endif %}
          <img src="{{ iiidem_img }}" alt="Background Image" class="stats-bg">

            <!-- Blue Overlay -->
            <div class="stats-overlay"></div>
            <!-- Cross Lines -->
            <div class="cross-horizontal"></div>
            <div class="cross-vertical"></div>
            <!-- Dynamic Statistics -->
            <div class="stats-grid">
              <!-- Items -->
              {% for item in home_about_block.field_statistics %}
                {% set stat = item.entity %}
              <div class="stat-box">
                <div class="stat-icon">
                   {% if stat.field_icon.entity %}
                  <img src="{{ file_url(stat.field_icon.entity.uri.value) }}" alt="">
                  {% endif %}
                </div>
                <h2 class="stat-number">{{ stat.field_number.value }}+</h2>
                <p class="stat-text">
                  {{ stat.field_label.value }}
                </p>
              </div>
              {% endfor %}
            </div>
          </div>
          </div>
        </div>
      </div>
    </section>


      <!-- Statistic Section end -->

       <!-- Event Start -->
  <section class="py-5">
     {{ page.homepage_event }}
  </section>
   <!-- Event End -->

      <!-- About Section on Home page Start -->
      <div class="container">
        <div class="text-center mb-5">
          <span class="gov-line"></span>
          <h2 class="gov-title"> About IIIDEM</h2>
          <p><img src="https://iiidem.eci.gov.in/newimg/iiidem-vLogo.png" alt=""></p>
          <span class="gov-line"></span>
        </div>

        {% if about_tabs_node %}
          <div class="row g-4">
            {% for item in about_tabs_node.field_about_tabs %}
              {% set tab = item.entity %}
              <div class="col-lg-4 col-md-6">
                <div class="gov-card h-100 text-center">
                  <div class="gov-icon">
                    <i class="fas fa-file-signature"></i>
                  </div>
                  <h3>{{ tab.field_tab_title.value }}</h3>
                  <p>
                    {{ tab.field_about_tab_content.value|striptags|slice(0,120) }}...
                  </p>
                 <a href="/about-us#tab{{ loop.index }}" class="gov-btn">
                  Explore Programs
                </a>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
    </div>
  <!-- About Section End -->


  <!-- =========================================
     Media Gallery Section (Government Style)
     Image Gallery + Video Gallery
========================================= -->

<section class="media-section py-5">
  <div class="container">

    <!-- Section Heading -->
    <div class="section-heading text-center mb-5">
      <span class="gov-line"></span>
      <h2 class="gov-title">Media Gallery</h2>
      <span class="gov-line"></span>
    </div>

    <div class="row g-4">

      <!-- ===============================
           Image Gallery
      =============================== -->
      <div class="col-lg-6">

        <div class="gov-media-box">
          <div class="media-title">
            <i class="fas fa-image"></i> IIIDEM Image Gallery
