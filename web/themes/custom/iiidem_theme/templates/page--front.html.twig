      <span class="gov-line"></span>
      <h2 class="gov-title">{{ mous.label() }}</h2>
      <span class="gov-line"></span>
    </div>
    <!-- Slider -->

   <div class="swiper clientSwiper">
  <div class="swiper-wrapper">

    {% for item in mous.field_admin_institutes %}
      
      {% set paragraph = item.entity %}

        {{dump(paragraph.field_administrative_logo)}}
      
      {% if paragraph and paragraph.field_administrative_logo.entity %}
