
{% include '@iiidem_theme/components/header/header.twig' with {
  logo: logo,
  site_name: site_name,
  page: page
} %}

<main>
    {{ content.field_components }}

    <!-- Carousel Start -->
    {% if node is defined and node.field_hero_banner is not empty %}
      <div class="carousel-header">
        <div id="carouselId" class="carousel slide" data-bs-ride="carousel">

          <!-- Indicators -->
          <ol class="carousel-indicators">
            {% for item in node.field_hero_banner %}
              <li data-bs-target="#carouselId"
                  data-bs-slide-to="{{ loop.index0 }}"
                  class="{% if loop.first %}active{% endif %}">
              </li>
            {% endfor %}
          </ol>

          <!-- Slides -->
          <div class="carousel-inner" role="listbox">

            {% for item in node.field_hero_banner %}
              {% set slide = item.entity %}

              <div class="carousel-item {% if loop.first %}active{% endif %}">

                {% if slide.field_slide_image.entity %}
                  <img src="{{ file_url(slide.field_slide_image.entity.fileuri) }}"
                       class="d-block w-100 img-fluid"
                       alt="{{ slide.field_title.value }}">
                {% endif %}

                <div class="carousel-caption">
                  <h1>{{ slide.field_title.value }}</h1>
                  <p>{{ slide.field_slide_description.value }}</p>
                </div>

              </div>

            {% endfor %}

          </div>

          <!-- Controls -->
          <button class="carousel-control-prev" type="button" data-bs-target="#carouselId" data-bs-slide="prev">
            <span class="carousel-control-prev-icon bg-secondary" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>

          <button class="carousel-control-next" type="button" data-bs-target="#carouselId" data-bs-slide="next">
            <span class="carousel-control-next-icon bg-secondary" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>

        </div>
      </div>
    {% endif %}
    <!-- Homepage Carousel End -->

    <!-- Services Start -->
      {{ page.homepage_services }}
    <!-- Services End -->

     <!-- training Start -->
      {{ page.homepage_training }}
    <!-- training End -->

    <!-- Statistic Section start by custom block content (Home statistical data)-->

    {% if home_about_block.field_image.entity %}
      {% set logo_img = file_url(home_about_block.field_image.entity.fileuri) %}
    {% endif %}
    <section class="home-about py-5">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <img src="{{ logo_img }}" alt="">
            <div class="about-desc">
                {{ home_about_block.field_description.value |raw  }}
            </div>
              <div class="stats-grid">
                {% for item in home_about_block.field_statistics %}
                  {% set stat = item.entity %}
                  <div class="stat-box">
                    {% if stat.field_icon.entity %}
                      <img src="{{ file_url(stat.field_icon.entity.uri.value) }}" alt="">
                    {% endif %}
                    <p>{{ stat.field_label.value }}</p>
                    <h3>{{ stat.field_number.value }}</h3>
                  </div>
                {% endfor %}
              </div>
              </div>
              {% if home_about_block.field_home_iiidem_image.entity %}
                {% set iiidem_img = file_url(home_about_block.field_home_iiidem_image.entity.fileuri) %}
              {% endif %}
               <div class="col-lg-6"><img src="{{ iiidem_img }}" alt=""> </div>
            </div>
          </div>
      </section>
      <!-- Statistic Section end -->

      <!-- About Section on Home page Start -->
      <div class="container">
        <div class="text-center mb-5">
          <span class="gov-line"></span>
          <h2 class="gov-title"> About IIIDEM</h2>
          <p><img src="https://iiidem.eci.gov.in/newimg/iiidem-vLogo.png" alt=""></p>
          <span class="gov-line"></span>
        </div>

        {% if about_tabs_node %}
          <div class="row g-4">
            {% for item in about_tabs_node.field_about_tabs %}
              {% set tab = item.entity %}
              <div class="col-lg-4 col-md-6">
                <div class="gov-card h-100 text-center">
                  <div class="gov-icon">
                    <i class="fas fa-file-signature"></i>
                  </div>
                  <h3>{{ tab.field_tab_title.value }}</h3>
                  <p>
                    {{ tab.field_about_tab_content.value|striptags|slice(0,120) }}...
                  </p>
                 <a href="/about-us#tab{{ loop.index }}" class="gov-btn">
                  Explore Programs
                </a>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
    </div>
  <!-- About Section End -->


  <!-- =========================================
     Media Gallery Section (Government Style)
     Image Gallery + Video Gallery
========================================= -->

<section class="media-section py-5">
  <div class="container">

    <!-- Section Heading -->
    <div class="section-heading text-center mb-5">
      <span class="gov-line"></span>
      <h2 class="gov-title">Media Gallery</h2>
      <span class="gov-line"></span>
    </div>

    <div class="row g-4">

      <!-- ===============================
           Image Gallery
      =============================== -->
      <div class="col-lg-6">

        <div class="gov-media-box">
          <div class="media-title">
            <i class="fas fa-image"></i> IIIDEM Image Gallery
          </div>
         <!--  <span class="gov-line"></span> -->

          {{ page.homepage_image_gallery }}

          <div class="text-center mt-4">
            <a href="/photo-gallery" class="gov-btn">View All Photos</a>
          </div>
        </div>

      </div>


      <!-- ===============================
           Video Gallery
      =============================== -->
      <div class="col-lg-6">
        <div class="gov-media-box">
          <div class="media-title">
            <i class="fas fa-video"></i> Video Gallery
          </div>
          <div class="ratio ratio-16x9 mb-3">
            <iframe width="360" height="315" src="https://www.youtube.com/embed/J-51AZHKcCo?si=peB6cxWgZuwzjzxz" ></iframe>
          </div>
          <div class="text-center mt-4">
            <a href="/video-gallery" class="gov-btn">View All Videos</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ===============================
IIIDEM Global Training Footprint Animated Bar Chart Version
================================ -->

<section class="footprint-section py-5">
  <div class="container">
    <!-- Heading -->
    <div class="section-heading text-center mb-5">
      <span class="gov-line"></span>
      <h2 class="gov-title">{{ global_footprint.label() }}</h2>
      {% if global_footprint %}
        <p>
          IIIDEM Presence Across
          <span class="highlight">
            {{ global_footprint.field_total_region_countries.value }}
          </span>
          Countries
        </p>
      {% endif %}
      <span class="gov-line"></span>
    </div>

    <!-- Chart -->
     {# Find MAX value #}
      {% set max = 0 %}
      {% for item in global_footprint.field_total_countries %}
        {% set val = item.entity.field_region_value.value|number_format %}
        {% if val > max %}
          {% set max = val %}
        {% endif %}
      {% endfor %}

    <div class="row">
      <div class="col-sm-6">
        <div class="chart-wrapper">
          {% for item in global_footprint.field_total_countries %}
            {% set region = item.entity %}
            {% set value = region.field_region_value.value %}
            {% set percent = (value / max) * 100 %}
            {% set color = region.field_color.value|default('#3b82f6') %}
            <div class="chart-row">
              <div class="chart-label">
                {{ region.field_region_name.value }}
              </div>
              <div class="chart-bar">
                <div class="chart-fill"
                     data-width="{{ percent }}"
                     style="background-color: {{ color }};">
                </div>
              </div>
              <div class="chart-value" data-value="{{ value }}">  0 </div>
            </div>
          {% endfor %}
        </div>
      </div>
   
      <div class="col-sm-6">
        {% if global_footprint.field_footprint_image.entity %}
          <img  src="{{ file_url(global_footprint.field_footprint_image.entity.fileuri) }}"
            alt="{{ global_footprint.field_footprint_image.alt }}" class="img-fluid rounded" >
        {% endif %}
      </div>
    </div>
  </div>
</section>

<!-- ===============================
IIIDEM partners Setion
================================ -->

{% if partners.field_partner_section_background.entity %}
  {% set bg = file_url(partners.field_partner_section_background.entity.fileuri) %}
{% endif %}

<section class="media-section py-5" style="background-image: url('{{ bg }}');">
    <!-- Section Heading -->
    <div class="section-heading text-center mb-5">
      <span class="gov-line"></span>
      <h2 class="gov-title">{{ partners.label() }}</h2>
      <span class="gov-line"></span>
    </div>
    <!-- Slider -->
    <div class="partner-slider">
      <div class="partner-track">
        {% for item in partners.field_partners_slider %}
          {% set paragraph = item.entity %}
          {% if paragraph.field_partner_logo_image.entity %}
            <div class="partner-item">
              <img  src="{{ file_url(paragraph.field_partner_logo_image.entity.fileuri) }}"
                alt="{{ paragraph.field_partner_logo_image.alt }}" >
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>


<!-- ===============================
IIIDEM international_organizations Setion
================================ -->

<section class="media-section py-5" >
    <!-- Section Heading -->
    <div class="section-heading text-center mb-5">
      <span class="gov-line"></span>
      <h2 class="gov-title">{{ international_organizations.label() }}</h2>
      <span class="gov-line"></span>
    </div>
    <!-- Slider -->
    <div class="swiper clientSwiper">
      <div class="swiper-wrapper">
        {% for item in international_organizations.field_partnership_logo %}
          {% if item.entity and item.entity.field_organization_logo.entity %}
            <div class="swiper-slide">
              <img src="{{ file_url(item.entity.field_organization_logo.entity.fileuri) }}"
                alt="{{ item.entity.field_organization_logo.alt|default('Logo') }}" />
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>



