<div class="events-wrapper">
  <div class="container">
    <form{{ attributes.addClass('custom-exposed-form') }}>
      <div class="filter-wrapper">
        <div class="filter-field">
          {{ form.title }}
        </div>
        <div class="filter-actions">
          {{ form.actions }}
        </div>
      </div>
    </form>
  </div>
</div