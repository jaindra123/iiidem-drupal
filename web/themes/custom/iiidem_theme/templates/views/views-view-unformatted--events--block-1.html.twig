<div class="container-fluid px-0">
  {% for row in rows %}
    {% set node = row.content['#row']._entity %}
    <div class="event-section">
      <div class="event-heading">
        Current Event
      </div>
      <div class="container">
        <div class="row align-items-center">
          <!-- Left Image -->
          <div class="col-lg-4">
            {% if node.field_event_image.entity %}
              <img src="{{ file_url(node.field_event_image.entity.uri.value) }}" alt="{{ node.title.value }}" class="main-event-img" >
            {% endif %}
          </div>
          <!-- Content -->
          <div class="col-lg-8">
            <div class="event-content">
              <p>
                {{ node.body.value|striptags|slice(0, 220) }}
                <a href="{{ path('entity.node.canonical', {'node': node.id()}) }}">
                  Read More →
                </a>
              </p>
              <div class="event-date">
                <span>
                   {{ node.field_start_date.value|date("jS F, Y") }} -
                   {{ node.field_end_date.value|date("jS F, Y") }}
                </span>
              </div>
              <!--  block 2-->
              {{ drupal_view('events', 'block_2') }}

            </div>
          </div>
        </div>
      </div>
    </div>
  {% endfor %}
</div>