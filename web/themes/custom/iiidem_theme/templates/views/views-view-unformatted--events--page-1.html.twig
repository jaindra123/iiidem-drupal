{# Get current timestamp ONCE #}
{% set now = "now"|date("U") %}

<div class="events-wrapper">
  <div class="container">
  {# ================= UPCOMING EVENTS ================= #}
  <section class="events-section upcoming">
    <h2 class="section-title">Upcoming Events</h2>
    <div class="cards-grid">
      {% for row in rows %}
        {% set event = row.content['#row']._entity %}

        {% if event.field_end_date.end_value is defined %}
          {% set end_date = event.field_end_date.end_value|date("U") %}
        {% else %}
          {% set end_date = event.field_end_date.value|date("U") %}
        {% endif %}
        {% if end_date >= now %}
          <div class="event-card upcoming-card">
            <div class="event-image">
              {% set image_item = event.field_event_image.0 %}
              {% set file = image_item.entity %}
              {% if file %}
                <img src="{{ file_url(file.uri.value) }}" alt="{{ image_item.alt }}" class="img-fluid">
              {% endif %}
            </div>
            <div class="event-content">
              <h3 class=""> 
                <a href="{{ path('entity.node.canonical', {'node': event.id()}) }}"
                class="">{{ event.title.value }}</a> 
              </h3>

               {% set body_text = event.body.0.value|striptags %}
                <span class="event-detail">
                  {{ body_text|slice(0, 120) }}

                  {% if body_text|length > 120 %}
                    ...
                  {% endif %}
                </span>

                {% if body_text|length > 120 %}
                  <span><a href="{{ path('entity.node.canonical', {'node': event.id()}) }}"
                     class="read-more">
                    Read More
                  </a></span>
                {% endif %}

              <!-- <a href="{{ path('entity.node.canonical', {'node': event.id()}) }}"
                class="event-btn">View More </a> -->
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  {# ================= PAST EVENTS ================= #}
  
  <section class="events-section past">
    <h2 class="section-title">Past Events</h2>
    <div class="cards-grid">
      {% for row in rows %}
        {% set event = row.content['#row']._entity %}

        {% if event.field_end_date.end_value is defined %}
          {% set end_date = event.field_end_date.end_value|date("U") %}
        {% else %}
          {% set end_date = event.field_end_date.value|date("U") %}
        {% endif %}
        {% if end_date < now %}
          <div class="event-card past-card">
            <div class="event-image">
              {% set image_item = event.field_event_image.0 %}
              {% set file = image_item.entity %}
              {% if file %}
                <img src="{{ file_url(file.uri.value) }}"alt="{{ image_item.alt }}"  class="img-fluid">
              {% endif %}
            </div>
            <div class="event-content">
              <h3 class=""> 
                <a href="{{ path('entity.node.canonical', {'node': event.id()}) }}"
                class="">{{ event.title.value }}</a> 
              </h3>
              {% set body_text = event.body.0.value|striptags %}
                <span class="event-detail">
                  {{ body_text|slice(0, 120) }}

                  {% if body_text|length > 120 %}
                    ...
                  {% endif %}
                </span>

                {% if body_text|length > 120 %}
                  <span><a href="{{ path('entity.node.canonical', {'node': event.id()}) }}"
                     class="read-more">
                    Read More
                  </a></span>
                {% endif %}
             <!--  <a href="{{ path('entity.node.canonical', {'node': event.id()}) }}"  class="event-btn" >
                View Details</a> -->
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>

</div>
</div>