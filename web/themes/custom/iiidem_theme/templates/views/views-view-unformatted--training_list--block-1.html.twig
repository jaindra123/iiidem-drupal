
  <div class="container">
    {# Section Heading #}
    <div class="text-center mb-5">
      <span class="gov-line"></span>
      <h2 class="gov-title">
        IIIDEM’S TRAINING PROGRAMS & ACADEMIC COURSES
      </h2>
      <p class="gov-subtitle">
        IIIDEM is one of the few institutions in the world which is not only involved in the Training & Capacity Building Programs for its Electoral officials, but also catering to the requirements of Election Management Bodies (EMBs) world over.
      </p>
      <span class="gov-line"></span>
    </div>

    <div class="row g-4">
      {% for row in rows %}
        {% set node = row.content['#row']._entity %}

        <div class="col-lg-4 col-md-6">
          <div class="gov-card h-100 text-center">

            <!-- Image -->
            <div class="">
              {% if node.field_training_image.entity %}
                <img 
                  src="{{ file_url(node.field_training_image.entity.fileuri) }}" 
                  alt="{{ node.label() }}" 
                  class="img-fluid">
              {% endif %}
            </div>

            <!-- Title -->
            <h3>
              <a href="{{ path('entity.node.canonical', {'node': node.id() }) }}">
                {{ node.label() }}
              </a>
            </h3>

            <!-- Description -->
             <p>
              {{ node.body.value|striptags|slice(0,140) }}...
              <a href="{{ path('entity.node.canonical', {'node': node.id() }) }}">
                Read More →
              </a>
            </p>

            <!-- Button -->
            <a href="{{ path('entity.node.canonical', {'node': node.id() }) }}" class="gov-btn">
              Explore Programs
            </a>

          </div>
        </div>
      {% endfor %}
    </div>


  </div>
</section>


