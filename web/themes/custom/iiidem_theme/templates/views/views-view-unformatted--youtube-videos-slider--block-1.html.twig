
<div class="swiper youtubeSwiper">
  <div class="swiper-wrapper">
    {% for row in rows %}
      {% set node = row.content['#row']._entity %}
      <div class="swiper-slide">
        <div class="video-card">
          <iframe
            width="100%"
            height="250"
            src="https://www.youtube.com/embed/{{ node.field_youtube_video_url.uri|split('v=')|last }}"
            frameborder="0"
            allowfullscreen>
          </iframe>
          <h4>{{ node.field_published_date.value }}</h4>
        </div>
      </div>
    {% endfor %}
  </div>
</div>