
<ul class="navbar-nav">

  {% for item in items %}
    <li class="nav-item {% if item.below %}has-submenu{% endif %}">

      <a href="{{ item.url }}" class="nav-link">

        {{ item.title }}

        {# Show arrow only if submenu exists #}
        {% if item.below %}
          <span class="submenu-arrow">
            <i class="bi bi-chevron-down"></i>
          </span>
        {% endif %}

      </a>

      {% if item.below %}
        <ul class="menu">
          {% for child in item.below %}
            <li>
              <a href="{{ child.url }}">{{ child.title }}</a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

    </li>
  {% endfor %}

</ul>